NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://pathproof:pathproof@localhost:5432/pathproof
# Optional when DATABASE_URL uses a TLS-enabled hosted PostgreSQL service
DATABASE_SSL=false
# Public OSRM foot routing server; replace with a contracted provider/self-hosted instance for production SLA
ROUTING_BASE_URL=https://routing.openstreetmap.de/routed-foot
# Nominatim usage requires a descriptive application User-Agent and rate-limit compliance
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
